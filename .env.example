# Conexión a MySQL 8
DATABASE_URL="mysql://sueldos:CAMBIAR@127.0.0.1:3306/sueldos"

# Secreto compartido que oauth2-proxy inyecta en el header X-Proxy-Auth (§3.2)
PROXY_SHARED_SECRET="CAMBIAR-por-un-secreto-largo"

# Email del primer administrador; solo se usa si la tabla usuarios está vacía (§3.3)
BOOTSTRAP_ADMIN_EMAIL="admin@ejemplo.com"

# Token del endpoint POST /api/cron/licencias (§7.12)
CRON_TOKEN="CAMBIAR-por-un-token-largo"

TZ="America/Montevideo"

# Solo desarrollo. Formato: email|nombre|admin  (§3.2 punto 4)
# DEV_IMPERSONATE_USER="admin@ejemplo.com|Administrador|true"
